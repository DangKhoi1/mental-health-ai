# ══════════════════════════════════════════════════════════════════
#  MENTAL HEALTH AI — Docker Environment Configuration
#  Sao chép file này thành .env và điền giá trị thực
# ══════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=mental_health_db

# ── Backend (NestJS) ───────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_DATABASE=mental_health_db

JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

AI_SERVICE_URL=http://ai-service:5001
AI_RECOMMENDATION_CRON=0 0 * * *
AI_REQUEST_TIMEOUT_MS=120000
AI_HEALTH_TIMEOUT_MS=10000

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://YOUR_DOMAIN/api/v1/auth/google/callback

# Danh sách domain frontend được phép gọi API (ngăn cách bởi dấu phẩy)
ALLOWED_ORIGINS=http://YOUR_DOMAIN,https://YOUR_DOMAIN,http://YOUR_DOMAIN/admin

# ── AI Service (Python/FastAPI) ────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
APP_ENV=production
WORKERS=2

# ── Frontend & Admin (Next.js) ─────────────────────────────────────
# Đây là URL public mà browser sẽ gọi vào (phải là domain thực)
NEXT_PUBLIC_API_URL=http://YOUR_DOMAIN/api/v1
